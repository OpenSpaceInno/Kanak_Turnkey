# =============================================================================
# Kanak Turnkey Projects — Environment Configuration
# =============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# MySQL Database Connection (Default root password: root)
MYSQL_URL=mysql://root:root@127.0.0.1:3306/kanak_turnkey
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=kanak_turnkey

# PostgreSQL / Supabase Database Connection
# Leave blank or file:./local.db to use embedded PGlite
DATABASE_URL=file:./local.db
# Example Supabase/PG:
# DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/kanak_turnkey

# CORS Configuration (comma-separated origins or * for all)
# Example for HTTPS deployment: CORS_ORIGIN=https://kanakturnkey.com,https://app.kanakturnkey.com
CORS_ORIGIN=*

# Frontend API URL (if frontend is hosted on separate domain/subdomain)
# VITE_API_URL=https://api.kanakturnkey.com
