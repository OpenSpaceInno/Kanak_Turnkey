# =============================================================================
# Docker Deployment Environment Variables
# =============================================================================

PORT=3000
NODE_ENV=production

# MySQL (password: root)
MYSQL_URL=mysql://root:root@db:3306/kanak_turnkey
MYSQL_HOST=db
