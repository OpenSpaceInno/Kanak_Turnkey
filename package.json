{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-all.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:mysql:setup": "node scripts/setup-mysql.mjs",
    "db:mysql:push": "pnpm --filter @workspace/db run push:mysql",
    "db:test": "node test-db-connection.js"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.6",
    "pg": "^8.20.0",
    "rollup": "4.59.0"
  }
}
